name: Check BML SML integration kit
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  tests:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@v7.1.0
        with:
          node-version: '22'
      - uses: actions/setup-python@v7.1.0
        with:
          python-version: '3.12'
      - name: Source manifest
        run: python prepare.py --verify
      - name: Install test dependencies
        run: python -m pip install tzdata cryptography
      - name: JavaScript tests
        run: node --test tests/*.test.js
      - name: Fake terminal tests
        run: python -m unittest discover -s tests -p 'test_*.py'
